<idea-plugin>
  <id>com.example.communityhttpclient</id>
  <name>Community HTTP Client</name>
  <vendor email="support@example.com" url="https://www.example.com">YourCompany</vendor>

  <description><![CDATA[
    Provides support for .http files, enabling easy API interaction and testing directly within the IDE.
  ]]></description>

  <!-- please see https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html
       on how to target different products -->
  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileTypeFactory implementation="com.example.communityhttpclient.lang.HTTPFileTypeFactory"/>
    <lang.parserDefinition language="HTTP" implementationClass="com.example.communityhttpclient.lang.parser.HTTPParserDefinition"/>
    <lang.syntaxHighlighterFactory language="HTTP" implementationClass="com.example.communityhttpclient.lang.highlight.HTTPSyntaxHighlighterFactory"/>
    <completion.contributor language="HTTP" implementationClass="com.example.communityhttpclient.completion.HTTPCompletionContributor"/>
    <toolWindow id="CommunityHttpClient.RequestResponseToolWindow"
                anchor="bottom"
                factoryClass="com.example.communityhttpclient.toolwindows.RequestResponseToolWindowFactory"
                icon="AllIcons.General.Messages"/>
  </extensions>

  <actions>
    <group id="CommunityHttpClient.NewQuickAccessGroup" text="New..." popup="true">
      <add-to-group group-id="MainMenu" anchor="first"/>
      <action id="CommunityHttpClient.NewEmptyGetRequest"
              class="com.example.communityhttpclient.actions.NewEmptyGetRequestAction"
              text="GET Request"/>
      <action id="CommunityHttpClient.NewPostTextBodyRequest"
              class="com.example.communityhttpclient.actions.NewPostTextBodyRequestAction"
              text="POST Text Body"/>
      <action id="CommunityHttpClient.NewPostParametersBodyRequest"
              class="com.example.communityhttpclient.actions.NewPostParametersBodyRequestAction"
              text="POST Parameters Body"/>
      <action id="CommunityHttpClient.NewPostFormWithTextFieldRequest"
              class="com.example.communityhttpclient.actions.NewPostFormWithTextFieldRequestAction"
              text="POST Form with a Text Field"/>
      <action id="CommunityHttpClient.NewPostFormWithFileFieldRequest"
              class="com.example.communityhttpclient.actions.NewPostFormWithFileFieldRequestAction"
              text="POST Form with a File Field"/>
      <action id="CommunityHttpClient.NewGraphQLQueryRequest"
              class="com.example.communityhttpclient.actions.NewGraphQLQueryRequestAction"
              text="GraphQL Query Request"/>
      <action id="CommunityHttpClient.NewWebSocketRequest"
              class="com.example.communityhttpclient.actions.NewWebSocketRequestAction"
              text="WebSocket Request"/>
      <separator/>
      <action id="CommunityHttpClient.NewVariableInPublicFile"
              class="com.example.communityhttpclient.actions.NewVariableInPublicFileAction"
              text="Variable in Public File"/>
      <action id="CommunityHttpClient.NewVariableInPrivateFile"
              class="com.example.communityhttpclient.actions.NewVariableInPrivateFileAction"
              text="Variable in Private File"/>
      <separator/>
      <action id="CommunityHttpClient.NewAuthConfiguration"
              class="com.example.communityhttpclient.actions.NewAuthConfigurationAction"
              text="Auth Configuration"/>
    </group>
  </actions>
</idea-plugin>
